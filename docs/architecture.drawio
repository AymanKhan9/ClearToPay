        <mxCell id="e_call" value="tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.2429;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="s1">
          <mxGeometry relative="1" as="geometry" />
